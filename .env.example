# Скопируйте в .env для локального запуска или задайте эти переменные в Coolify.
NODE_ENV=production
PORT=3000
DATA_DIR=/data

# Входящий вебхук Mattermost: сюда приходят регистрации и обращения
MATTERMOST_WEBHOOK_URL=

# Пароль для страницы partnerka.io/admin (список лидов и выгрузка в CSV).
# Не короче 12 символов. Пока не задан, страница /admin отключена.
ADMIN_PASSWORD=
