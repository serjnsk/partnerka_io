# Скопируйте в .env для локального запуска или задайте эти переменные в Coolify.
NODE_ENV=production
PORT=3000
DATA_DIR=/data

# SMTP для писем с кодом подтверждения (любой провайдер: Яндекс 360, Mail.ru, Unisender Go и т. п.)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@partnerka.io
SMTP_PASS=
SMTP_FROM="partnerka.io <noreply@partnerka.io>"

# Входящий вебхук Mattermost: сюда приходят регистрации, лиды и обращения
MATTERMOST_WEBHOOK_URL=
